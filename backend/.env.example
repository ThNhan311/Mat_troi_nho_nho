# Documentation template only; Spring does not automatically load this file.
# Default/legacy read environment; do not point these at a shared DB for rehearsal.
DB_URL=
# Supply the exact new authority datasource from core-readiness; never copy an old DB name.
DB_USERNAME=
DB_PASSWORD=
JWT_SECRET=
SERVER_PORT=18086
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
# Real OTP mail (SMTP, Gmail by default). Off by default: the loopback test sink is used.
# Keep real values outside Git; the password is a Gmail App Password.
FITCENTER_MAIL_SMTP_ENABLED=false
FITCENTER_SMTP_USER=
FITCENTER_SMTP_APP_PASSWORD=
# Avatar files (outside Git). Off by default; core-demo turns it on.
FITCENTER_AVATAR_DIRECTORY=
# Flutter --dart-define, not a Backend environment variable:
API_BASE_URL=http://localhost:18086/api/v1

# Do not enable core-demo by hand: runner verifies full resource authority first.
# Default gates remain off. Core-demo is loopback test/dev, not production.
