              }
            }
          }
        }
      }
    },
    "/v2/captures/{request}/{capture}": {
      "get": {
        "summary": "Backend retrieves exact request/capture attestation",
        "security": [
          {
            "ControlToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Valid server result; Cache-Control: no-store",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_REQUEST / INVALID_UUID / INVALID_BINDING / INVALID_IMAGE / INSUFFICIENT_SAMPLES"
