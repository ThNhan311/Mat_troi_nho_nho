          }
        ],
        "responses": {
          "200": {
            "description": "Valid server result; Cache-Control: no-store"
          },
          "400": {
            "description": "INVALID_REQUEST / INVALID_UUID / INVALID_BINDING / INVALID_IMAGE / INSUFFICIENT_SAMPLES"
          },
