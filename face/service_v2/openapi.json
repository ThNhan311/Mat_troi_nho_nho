{
  "openapi": "3.0.3",
  "info": {
    "title": "FitCenter private Face Service v2 rehearsal",
    "version": "F03A",
    "description": "No public/browser API. Loopback runner only, no CORS. No PAD: NOT_PERFORMED, admissionEnabled=false. Explicit threshold/margin remain uncalibrated. Request <=12MiB, each decoded image <=2MiB/4096px. No raw image retention. Backend release/real admission remain gated."
  },
  "paths": {
    "/v2/health": {
      "get": {
        "summary": "Authenticated runtime/provenance; admissionEnabled=false",
        "security": [
          {
            "ControlToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Valid server result; Cache-Control: no-store"
          },
          "400": {
            "description": "INVALID_REQUEST / INVALID_UUID / INVALID_BINDING / INVALID_IMAGE / INSUFFICIENT_SAMPLES"
          },
          "401": {
            "description": "UNAUTHORIZED"
          },
          "409": {
            "description": "BINDING_CONFLICT / SAMPLE_CONFLICT / PREDECESSOR_CONFLICT / DUPLICATE_IDENTITY / TOMBSTONED / CAPTURE_REUSED / SAMPLE_NOT_READY"
          },
          "413": {
            "description": "TOO_LARGE"
          },
          "503": {
            "description": "BUSY: no implicit write replay"
          }
        }
      }
    },
    "/v2/operations": {
      "post": {
        "summary": "Immutable operation/Member/profile/predecessor binding; prepare retry returns same state",
        "security": [
          {
            "ControlToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Valid server result; Cache-Control: no-store",
